# Pick the model provider: `ollama` (default — local, open source, no AWS) or
# `bedrock` (Amazon Bedrock).
MODEL_PROVIDER=ollama

# --- Ollama / OpenAI-compatible (default) -----------------------------------
# Runs against a local open-source model. Install Ollama, run `ollama pull
# llama3.1` and `ollama serve`, and these defaults work as-is. The base URL is
# Ollama's OpenAI-compatible endpoint. The api key is a non-empty dummy: the
# local server ignores it, but the client requires a value.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL_ID=llama3.1
OPENAI_API_KEY=ollama

# --- Amazon Bedrock (alternative) -------------------------------------------
# To use Bedrock instead, set MODEL_PROVIDER=bedrock above and configure these.
# AWS credentials come from the standard chain (aws configure / env vars).
# MODEL_PROVIDER=bedrock
# AWS_REGION=us-east-1
# VERIFY this id against the current Bedrock catalog and your enabled region
# before the demo (ids drift — retired ids return ResourceNotFoundException).
# Pick a small, cheap, enabled model. List yours with:
#   aws bedrock list-inference-profiles --region $AWS_REGION
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
